# Mode configuration
SAGE_X3_MODE=expert  # Options: 'expert' or 'trainer'
USE_MODE_SELECTOR=true  # Enable switching between modes

# Server configuration
HOST=0.0.0.0
PORT=8900
WORKERS=2

# Storage paths
DATA_DIR=./data

# Document processing
SPLIT_CHUNK_SIZE=1000
SPLIT_OVERLAP=100

# LLM configuration
MODEL_NAME=gemma3:12b
OLLAMA_BASE_URL=http://localhost:11434
TEMPERATURE=0.3

# Embeddings configuration
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5

# RAG configuration
SIMILAR_DOCS_COUNT=4

MODEL_NAME=gemma3:4b
PRELOAD_MODEL=false

EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDINGS_CACHE_SIZE=1000

SPLIT_CHUNK_SIZE=700
SPLIT_OVERLAP=100

SIMILAR_DOCS_COUNT=3

MODEL_TIMEOUT=600
WEBSOCKET_TIMEOUT=600

WORKERS=1